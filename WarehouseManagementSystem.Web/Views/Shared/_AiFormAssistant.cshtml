@model WarehouseManagementSystem.Web.Models.AI.AiFormAssistantModel

<div class="detail-card mb-4">
    <div class="d-flex align-items-center mb-3">
        <div class="bg-info text-white rounded p-3 me-3 fw-bold">
            AI
        </div>

        <div>
            <div class="text-muted small fw-bold text-uppercase">AI Assistant</div>
            <h4 class="fw-bolder mb-0">@Model.Title</h4>
        </div>
    </div>

    <div class="form-group mb-3">
        <label class="control-label fw-bold">Describe @Model.Entity</label>
        <textarea class="form-control rounded-4"
                  rows="3"
                  data-ai-prompt="@Model.Entity"
                  placeholder="@Model.Placeholder"></textarea>
    </div>

    <button type="button"
            class="btn btn-outline-info rounded-pill fw-bold px-4"
            data-ai-generate
            data-entity="@Model.Entity">
        Generate form data
    </button>

    <div class="mt-3" data-ai-message="@Model.Entity"></div>
</div>