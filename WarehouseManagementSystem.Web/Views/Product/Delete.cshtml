@model WarehouseManagementSystem.Model.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">PRODUCTS</a> &gt;
    <a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a> &gt;
    Delete
</div>

<h1 class="page-title">Delete Product @Model.Name</h1>

<div class="row g-4">
    <div class="col-md-7">
        <div class="detail-card border-0 h-100">
            <div class="d-flex align-items-center mb-4">
                <div class="bg-danger text-white rounded p-3 me-3">
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1 0-2H5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1h2.5a1 1 0 0 1 1 1M4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                    </svg>
                </div>

                <div>
                    <h5 class="fw-bolder mb-1 text-uppercase text-muted" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                        Delete Confirmation
                    </h5>
                    <h4 class="fw-bolder text-danger">This action cannot be undone</h4>
                </div>
            </div>

            <div class="alert alert-danger rounded-4 fw-bold">
                Are you sure you want to permanently delete this product?
            </div>

            <div class="row mt-4 pt-3 border-top">
                <div class="col-sm-6 mb-3">
                    <div class="text-muted small fw-bold text-uppercase">Tracking ID</div>
                    <div class="fw-bolder text-primary fs-5">
                        PRD-@Model.Id.ToString("0000")
                    </div>
                </div>

                <div class="col-sm-6 mb-3">
                    <div class="text-muted small fw-bold text-uppercase">Product Name</div>
                    <div class="fw-bolder text-dark fs-5">
                        @Model.Name
                    </div>
                </div>

                <div class="col-sm-6 mb-3">
                    <div class="text-muted small fw-bold text-uppercase">Category</div>
                    <div class="fw-bolder text-dark">
                        @(Model.Category?.Name ?? "Uncategorized")
                    </div>
                    <div class="small text-muted">
                        Category ID: @Model.CategoryId
                    </div>
                </div>

                <div class="col-sm-6 mb-3">
                    <div class="text-muted small fw-bold text-uppercase">Weight</div>
                    <div class="fw-bolder text-dark">
                        @Model.Weight.ToString("0.0") kg
                    </div>
                </div>

                <div class="col-sm-6 mb-3">
                    <div class="text-muted small fw-bold text-uppercase">Received At</div>
                    <div class="fw-bolder text-dark">
                        @Model.ProductReceivedAt.ToString("yyyy-MM-dd HH:mm")
                    </div>
                </div>

                <div class="col-sm-6 mb-3">
                    <div class="text-muted small fw-bold text-uppercase">Unit Price</div>
                    <div class="fw-bolder text-success fs-5">
                        @Model.Price.ToString("C")
                    </div>
                </div>

                <div class="col-md-12 mb-3">
                    <div class="text-muted small fw-bold text-uppercase">Description</div>
                    <div class="fw-bolder text-muted">
                        @Model.Description
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="detail-card border-0 h-100">
            <h5 class="text-muted small fw-bold text-uppercase mb-3" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                Product Impact
            </h5>

            <div class="mb-4">
                <div class="text-muted small fw-bold text-uppercase">Financial Value</div>
                <div class="fs-1 fw-bolder text-danger">
                    @Model.Price.ToString("C")
                </div>
            </div>

            <div class="alert alert-warning rounded-4 small fw-bold mb-0">
                Deleting this product may affect inventory records and purchase order items connected to it.
            </div>
        </div>
    </div>
</div>

<div class="mt-5 d-flex flex-wrap gap-3">
    <form asp-action="DeleteConfirmed"
          asp-route-id="@Model.Id"
          method="post"
          class="d-inline">
        @Html.AntiForgeryToken()

        <button type="submit" class="btn btn-danger px-4 fw-bold rounded-pill">
            Yes, Delete Product
        </button>
    </form>

    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-outline-primary px-4 fw-bold rounded-pill">
        Cancel
    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary px-4 fw-bold rounded-pill">
        &larr; Back to Products
    </a>
</div>