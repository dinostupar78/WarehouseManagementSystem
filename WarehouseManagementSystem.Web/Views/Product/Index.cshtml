@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; PRODUCTS
</div>
<h1 class="page-title">Product Index</h1>

<div class="row mb-4 align-items-stretch wms-index-metric-row">
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card border-start border-4 border-primary h-100 p-3">
            <div class="text-muted small fw-bold text-uppercase mb-2">
                Total Products
            </div>
            <div class="fs-4 fw-bolder text-primary">
                @ViewBag.TotalProducts Active Items
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="metric-card border-start border-4 border-info h-100 p-3">
            <div class="text-muted small fw-bold text-uppercase mb-2">
                Catalog Value
            </div>
            <div class="fs-4 fw-bolder text-info">
                @ViewBag.TotalCatalogValue.ToString("C")
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="metric-card border-start border-4 border-warning h-100 p-3">
            <div class="text-muted small fw-bold text-uppercase mb-2">
                Highest Value Product
            </div>
            <div class="fs-5 fw-bolder text-dark mb-1">
                @ViewBag.HighestValueProductName
            </div>
            <div class="small text-muted fw-bold">
                @ViewBag.HighestValueProductPrice.ToString("C")
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3 d-flex justify-content-xl-end align-items-center wms-index-create">
        <a asp-action="Create"
           class="btn btn-primary px-4 py-3 fw-bold rounded-pill shadow-sm wms-index-create-button">
            + Create Product Item
        </a>
    </div>
</div>

<div class="wms-list-search-panel mb-3">
    <div class="wms-list-search-header">
        <div>
            <div class="text-muted small fw-bold text-uppercase">Product List</div>
            <div class="fw-bolder">Search product records</div>
        </div>
    </div>

    <div class="wms-list-search-field">
        <input id="product-search"
               class="form-control rounded-pill"
               data-ajax-search
               data-search-url="/products/search"
               data-target="#product-table-body"
               placeholder="Search products by name, description, price, weight or category..." />

        <span class="wms-list-search-icon" aria-hidden="true">
            <svg width="20"
                 height="20"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
        </span>
    </div>
</div>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Name / Description</th>
                <th>Price</th>
                <th>Weight</th>
                <th>Received</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="product-table-body">
            <partial name="_ProductListPartial" model="Model" />
        </tbody>
    </table>
</div>

