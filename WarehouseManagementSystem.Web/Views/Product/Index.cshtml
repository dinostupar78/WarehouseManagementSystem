@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; PRODUCTS
</div>
<h1 class="page-title">Product Index</h1>

<div class="mb-4 d-flex justify-content-end">
    <a asp-action="Create"
       class="btn btn-primary px-4 py-3 fw-bold rounded-pill shadow-sm">
        + Create Product Item
    </a>
</div>

<div class="mb-3">
    <input id="product-search"
           class="form-control rounded-pill px-4"
           data-ajax-search
           data-search-url="/products/search"
           data-target="#product-table-body"
           placeholder="Search products by name, description, price, weight or category..." />
</div>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Product ID</th>
                <th>Name / Description</th>
                <th>Price</th>
                <th>Weight</th>
                <th>Received</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="product-table-body">
            <partial name="_ProductListPartial" model="Model" />
        </tbody>
    </table>
</div>

