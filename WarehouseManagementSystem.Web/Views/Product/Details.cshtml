@model WarehouseManagementSystem.Model.Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">PRODUCTS</a> &gt; 
    @Model?.Name
</div>
<h1 class="page-title">Product @Model?.Name</h1>

@if (Model == null)
{
    <div class="alert alert-secondary">Product not found.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923z"/></svg>
                    </div>
                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted">Product Data</h5>
                        <h4 class="fw-bolder">@Model.Name</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Tracking ID</div>
                        <div class="fw-bolder text-primary fs-5">PRD-@Model.Id.ToString("0000")</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Category</div>
                        <div class="fw-bolder">@(Model.Category?.Name ?? "Uncategorized")</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Weight</div>
                        <div class="fw-bolder">@Model.Weight.ToString("0.0")kg</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Received At</div>
                        <div class="fw-bolder">@Model.ProductReceivedAt.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                </div>
                
                <div class="mt-2 text-muted fw-bold">
                    <p>@Model.Description</p>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3">Financial Value</h5>
                <div class="mb-4">
                    <div class="text-muted small fw-bold text-uppercase">Unit Price</div>
                    <div class="fs-1 fw-bolder text-success">@Model.Price.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>
}

@if (Model != null)
{
    <div class="wms-detail-actions mt-5">
        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Record actions</div>
                <div class="fw-bolder">Manage this product</div>
            </div>

            <div class="wms-detail-action-buttons">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary px-4 fw-bold rounded-pill">
                    Edit Product
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger px-4 fw-bold rounded-pill">
                    Delete Product
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Related Product Views</div>
                <div class="fw-bolder">Explore related products</div>
            </div>

            <div class="wms-related-actions">
                <a asp-action="FindByCategory"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sourceProductId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Same Category</span>
                    <span>Products in @(Model.Category?.Name)</span>
                </a>

                <a asp-action="PriceAbove"
                   asp-route-minPrice="@Model.Price"
                   asp-route-sourceProductId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Price Filter</span>
                    <span>Above @Model.Price.ToString("C")</span>
                </a>

                <a asp-action="FindBySimilarWeight"
                   asp-route-id="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Weight Filter</span>
                    <span>Above @Model.Weight kg</span>
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group wms-detail-navigation-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Navigation</div>
                <div class="fw-bolder">Return to product list</div>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4 fw-bold rounded-pill wms-detail-back-link">
                &larr; Back to Products
            </a>
        </div>
    </div>
}
