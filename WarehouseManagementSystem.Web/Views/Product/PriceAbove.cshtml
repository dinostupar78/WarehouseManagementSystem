@model IReadOnlyList<WarehouseManagementSystem.Model.Product>
@{
    ViewData["Title"] = $"Products priced above ${ViewBag.MinPrice}";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">PRODUCTS</a> &gt; 
    Price Above $@ViewBag.MinPrice
</div>
<h1 class="page-title">Products priced above $@ViewBag.MinPrice</h1>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-secondary">No products found priced above $@ViewBag.MinPrice.</div>
}
else
{
    <div class="wms-table-container">
        <table class="table wms-table table-hover">
            <thead>
                <tr>
                    <th>Product ID</th>
                    <th>Name / Description</th>
                    <th>Price</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td class="text-primary fw-bolder small">PRD-@product.Id.ToString("0000")</td>
                        <td>
                            <div class="fw-bolder">@product.Name</div>
                            <div class="small text-muted">@product.Description</div>
                        </td>
                        <td>
                            <div class="fw-bold text-success">@product.Price.ToString("C")</div>
                        </td>
                        <td>
                            <a class="action-btn" asp-action="Details" asp-route-id="@product.Id">DETAILS</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_BackToSourceDetails" />
