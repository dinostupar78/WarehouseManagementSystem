@using WarehouseManagementSystem.Web.Models
@using WarehouseManagementSystem.Web.Models.AI

@model WarehouseManagementSystem.Model.Product

@{
    ViewData["Title"] = "Create Product";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">PRODUCTS</a> &gt;
    Create
</div>

<h1 class="page-title">Create Product</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    @await Html.PartialAsync("_AiFormAssistant", new AiFormAssistantModel
    {
        Entity = "product",
        Title = "Generate product data",
        Placeholder = "Example: Create a new product called Industrial Safety Helmet. It belongs to the Office Supplies category. Description: Yellow protective helmet for warehouse workers. Unit price is 10€. Weight is 0.45 kg. Product was received today at 09:30."
        })

    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923z" />
                        </svg>
                    </div>

                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                            Product Data
                        </h5>
                        <h4 class="fw-bolder">New Product</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label text-muted small fw-bold text-uppercase"></label>
                        <input asp-for="Name"
                               class="form-control rounded-pill px-4"
                               placeholder="Enter product name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">
                            Tracking ID
                        </label>
                        <div class="fw-bolder text-primary fs-5 mt-2">
                            PRD-NEW
                        </div>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Description" class="form-label text-muted small fw-bold text-uppercase"></label>
                        <textarea asp-for="Description"
                                  class="form-control rounded-4 px-4 py-3"
                                  rows="5"
                                  placeholder="Enter product description"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                    Financial Value
                </h5>

                <div class="mb-4">
                    <label asp-for="Price" class="form-label text-muted small fw-bold text-uppercase">
                        Unit Price
                    </label>

                    <div class="input-group">
                        <span class="input-group-text rounded-start-pill fw-bold text-muted">€</span>
                        <input asp-for="Price"
                               class="form-control rounded-end-pill px-4 fs-4 fw-bolder text-success"
                               placeholder="0.00" />
                    </div>

                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Weight" class="form-label text-muted small fw-bold text-uppercase">
                        Weight
                    </label>

                    <div class="input-group">
                        <input asp-for="Weight"
                               class="form-control rounded-start-pill px-4 fw-bolder"
                               placeholder="0.00" />
                        <span class="input-group-text rounded-end-pill fw-bold text-muted">kg</span>
                    </div>

                    <span asp-validation-for="Weight" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    @await Html.PartialAsync("_DateTimePicker", new DateTimePickerModel
                    {
                        FieldName = "ProductReceivedAt",
                        Label = "Received At",
                        Value = Model?.ProductReceivedAt
                    })
                </div>

                <div class="mb-4">
                    @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownModel
                    {
                        FieldName = "CategoryId",
                        Label = "Category",
                        Prefix = "CAT",
                        SearchUrl = Url.Action("Autocomplete", "Category") ?? "/categories/autocomplete",
                        Placeholder = "Search category by name...",
                        SelectedValue = Model != null && Model.CategoryId > 0 ? Model.CategoryId.ToString() : string.Empty,
                        SelectedText = Model?.Category?.Name
                    })
                </div>

                <div class="alert alert-secondary small fw-bold mb-0 rounded-4">
                    Assign this product to an existing category by searching and selecting it from the dropdown.
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 d-flex flex-wrap gap-3">
        <button type="submit" class="btn btn-primary px-4 fw-bold rounded-pill">
            Create Product
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">
            &larr; Back to Products
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
