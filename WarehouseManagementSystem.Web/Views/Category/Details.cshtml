@model WarehouseManagementSystem.Model.Category
@{
    ViewData["Title"] = "Category Details";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">CATEGORIES</a> &gt; 
    @Model?.Name
</div>
<h1 class="page-title">Category @Model?.Name</h1>

@if (Model == null)
{
    <div class="alert alert-secondary">Category not found.</div>
}
else
{
    <div class="detail-card border-0 h-100">
        <div class="d-flex align-items-center mb-4">
            <div class="bg-info text-white rounded p-3 me-3">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"/>
                </svg>
            </div>
            <div>
                <h5 class="fw-bolder mb-1 text-uppercase text-muted">Classification Data</h5>
                <h4 class="fw-bolder">@Model.Name</h4>
            </div>
        </div>

        <div class="row mt-4 pt-3 border-top">
            <div class="col-sm-6 mb-3">
                <div class="text-muted small fw-bold text-uppercase">Mapping ID</div>
                <div class="fw-bolder text-info fs-5">CAT-@Model.Id.ToString("0000")</div>
            </div>
            <div class="col-sm-6 mb-3">
                <div class="text-muted small fw-bold text-uppercase">Requirements</div>
                <div class="fw-bolder text-dark">@Model.Description</div>
            </div>
        </div>
    </div>
}

@if (Model != null)
{
    <div class="wms-detail-actions mt-5">
        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Record actions</div>
                <div class="fw-bolder">Manage this category</div>
            </div>

            <div class="wms-detail-action-buttons">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary px-4 fw-bold rounded-pill">
                    Edit Category
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger px-4 fw-bold rounded-pill">
                    Delete Category
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Related Category Views</div>
                <div class="fw-bolder">Explore related categories</div>
            </div>

            <div class="wms-related-actions">
                <a asp-action="WithProducts"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Used Categories</span>
                    <span>With products</span>
                </a>

                <a asp-action="WithoutProducts"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Empty Categories</span>
                    <span>Without products</span>
                </a>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    var keyword = Model.Description.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();

                    if (!string.IsNullOrWhiteSpace(keyword))
                    {
                        <a asp-action="ByDescriptionKeyword"
                           asp-route-keyword="@keyword"
                           asp-route-sourceId="@Model.Id"
                           class="wms-related-action-link">
                            <span class="wms-related-action-label">Description keyword</span>
                            <span>Matching "@keyword"</span>
                        </a>
                    }
                }
            </div>
        </div>

        <div class="wms-detail-action-group wms-detail-navigation-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Navigation</div>
                <div class="fw-bolder">Return to category list</div>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4 fw-bold rounded-pill wms-detail-back-link">
                &larr; Back to Categories
            </a>
        </div>
    </div>
}
