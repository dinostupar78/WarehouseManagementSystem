@model IReadOnlyList<Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; CATEGORIES
</div>
<h1 class="page-title">Category Management</h1>

<div class="mb-4 d-flex justify-content-end">
    <a asp-action="Create"
       class="btn btn-primary px-4 py-3 fw-bold rounded-pill shadow-sm">
        + Create Category Item
    </a>
</div>

<div class="mb-3">
    <input id="category-search"
           class="form-control rounded-pill px-4"
           data-ajax-search
           data-search-url="/categories/search"
           data-target="#category-table-body"
           placeholder="Search categories by name or description..." />
</div>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Category ID</th>
                <th>Classification Name</th>
                <th>Operational Requirements</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="category-table-body">
            <partial name="_CategoryListPartial" model="Model" />
        </tbody>
    </table>
</div>

