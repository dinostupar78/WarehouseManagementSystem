@using WarehouseManagementSystem.Web.Models.AI
@model WarehouseManagementSystem.Model.Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">CATEGORIES</a> &gt;
    Create
</div>

<h1 class="page-title">Create Category</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    @await Html.PartialAsync("_AiFormAssistant", new AiFormAssistantModel
    {
        Entity = "category",
        Title = "Generate category data",
        Placeholder = "Example: Create a category called Safety Equipment. Description: Protective equipment used by warehouse workers."
    })

    <div class="detail-card border-0 h-100">
        <div class="d-flex align-items-center mb-4">
            <div class="bg-info text-white rounded p-3 me-3">
                <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                </svg>
            </div>

            <div>
                <h5 class="fw-bolder mb-1 text-uppercase text-muted" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                    Classification Data
                </h5>
                <h4 class="fw-bolder">New Category</h4>
            </div>
        </div>

        <div class="row mt-4 pt-3 border-top">
            <div class="col-md-6 mb-3">
                <label asp-for="Name" class="form-label text-muted small fw-bold text-uppercase"></label>
                <input asp-for="Name"
                       class="form-control rounded-pill px-4"
                       placeholder="Enter category name" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-md-6 mb-3">
                <label class="form-label text-muted small fw-bold text-uppercase">
                    Mapping ID
                </label>
                <div class="fw-bolder text-info fs-5 mt-2">
                    CAT-NEW
                </div>
            </div>

            <div class="col-md-12 mb-3">
                <label asp-for="Description" class="form-label text-muted small fw-bold text-uppercase">
                    Requirements
                </label>
                <textarea asp-for="Description"
                          class="form-control rounded-4 px-4 py-3"
                          rows="5"
                          placeholder="Enter category description or requirements"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
        </div>
    </div>

    <div class="mt-5 d-flex flex-wrap gap-3">
        <button type="submit" class="btn btn-info text-white px-4 fw-bold rounded-pill">
            Create Category
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">
            &larr; Back to Categories
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
