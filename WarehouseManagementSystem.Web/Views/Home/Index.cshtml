@model WarehouseManagementSystem.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="wms-breadcrumbs">
    HOME &gt; DASHBOARD
</div>

<h1 class="page-title">Warehouse Overview</h1>
<p class="text-muted fw-bold mb-4">Real-time logistics and management for active operations.</p>

<div class="row mb-5 g-4 wms-dashboard-metric-grid">
    <div class="col-lg-3 col-md-6">
        <div class="detail-card wms-dashboard-metric border-start border-4 border-primary h-100">
            <div class="d-flex justify-content-between align-items-start gap-3 h-100">
                <div class="wms-dashboard-metric-copy">
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.1em;">Total Products</div>
                    <div class="wms-dashboard-metric-value">@Model.TotalProducts</div>
                    <div class="small fw-bolder text-muted">Products currently registered</div>
                </div>
                <div class="wms-dashboard-metric-icon bg-primary bg-opacity-10 text-primary">
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="detail-card wms-dashboard-metric border-start border-4 border-info h-100">
            <div class="d-flex justify-content-between align-items-start gap-3 h-100">
                <div class="wms-dashboard-metric-copy">
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.1em;">Active Suppliers</div>
                    <div class="wms-dashboard-metric-value">@Model.ActiveSuppliers</div>
                    <div class="small fw-bolder text-muted">Supplier records available</div>
                </div>
                <div class="wms-dashboard-metric-icon bg-info bg-opacity-10 text-info">
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="detail-card wms-dashboard-metric border-start border-4 border-danger h-100">
            <div class="d-flex justify-content-between align-items-start gap-3 h-100">
                <div class="wms-dashboard-metric-copy">
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.1em;">Pending Orders</div>
                    <div class="wms-dashboard-metric-value">@Model.PendingOrders</div>
                    <div class="small fw-bolder text-danger">@Model.PendingPurchaseOrders.Count active order alerts</div>
                </div>
                <div class="wms-dashboard-metric-icon bg-danger bg-opacity-10 text-danger">
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2z" />
                    </svg>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="detail-card wms-dashboard-metric border-start border-4 border-warning h-100">
            <div class="d-flex justify-content-between align-items-start gap-3 h-100">
                <div class="wms-dashboard-metric-copy">
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.1em;">Low Stock Items</div>
                    <div class="wms-dashboard-metric-value">@Model.LowStockItems</div>
                    <div class="small fw-bolder text-warning">Products at or below threshold</div>
                </div>
                <div class="wms-dashboard-metric-icon bg-warning bg-opacity-10 text-warning">
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.964 0L.165 13.233c-.457.778.091 1.767.982 1.767h13.706c.89 0 1.438-.99.982-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1-2 0 1 1 0 0 1 2 0" />
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <div class="detail-card border-0 h-100 wms-dashboard-section-card" style="padding: 1.5rem; background-color: var(--card-bg);">
            <div class="d-flex justify-content-between align-items-center mb-4 wms-dashboard-section-header">
                <h6 class="fw-bolder text-uppercase m-0" style="letter-spacing: 0.1em;">Recent Inventory Updates</h6>
                <a asp-controller="Inventory" asp-action="Index" class="fw-bold text-primary text-decoration-none small">View All</a>
            </div>

            <div class="table-responsive">
                <table class="table wms-table mb-0 table-hover mt-3">
                    <thead style="background-color: #eef2ff;">
                        <tr>
                            <th class="ps-3 border-0">Inventory ID</th>
                            <th class="border-0">Product</th>
                            <th class="border-0">Warehouse / Location</th>
                            <th class="border-0">Quantity</th>
                            <th class="border-0">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentInventory.Any())
                        {
                            foreach (var item in Model.RecentInventory)
                            {
                                <tr>
                                    <td class="ps-3 border-0 py-3" data-label="Inventory ID">
                                        @if (User.IsInRole("Admin") || User.IsInRole("Operator"))
                                        {
                                            <a asp-controller="Inventory"
                                               asp-action="Details"
                                               asp-route-id="@item.InventoryId"
                                               class="text-primary fw-bolder small text-decoration-none">
                                                #INV-@item.InventoryId.ToString("0000")
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-primary fw-bolder small">#INV-@item.InventoryId.ToString("0000")</span>
                                        }
                                    </td>
                                    <td class="border-0 py-3 text-dark fw-bold" data-label="Product">@item.ProductName</td>
                                    <td class="border-0 py-3 text-muted fw-bold" data-label="Warehouse / Location">@item.WarehouseName / @item.LocationCode</td>
                                    <td class="border-0 py-3 text-dark fw-bold" data-label="Quantity">@item.Quantity</td>
                                    <td class="border-0 py-3" data-label="Status">
                                        <span class="wms-badge wms-stock-badge @item.StockBadgeClass">
                                            @item.StockStatus
                                        </span>
                                        <div class="small text-muted fw-bold mt-2">@item.Quantity Units</div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted fw-bold py-4 border-0">
                                    No inventory updates available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-xl-4">
        <div class="detail-card border-0 h-100 d-flex flex-column wms-dashboard-section-card" style="background-color: #ffffff;">
            <div class="mb-auto">
                <h6 class="fw-bolder mb-4 text-uppercase d-flex align-items-center text-dark" style="letter-spacing: 0.1em;">
                    <svg width="18" height="18" fill="currentColor" class="me-2 text-primary" viewBox="0 0 16 16">
                        <path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2z" />
                        <path d="M4.5 4a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 1 0v-7a.5.5 0 0 0-.5-.5zm3 0a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 1 0v-7a.5.5 0 0 0-.5-.5zm3 0a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 1 0v-7a.5.5 0 0 0-.5-.5z" />
                    </svg>
                    Storage Efficiency
                </h6>

                <div class="progress mb-2 bg-white border" style="height: 8px; border-radius: 4px;">
                    <div class="progress-bar bg-primary"
                         role="progressbar"
                         style="width: @Model.TotalCapacityUsedPercent%; border-radius: 4px;"
                         aria-valuenow="@Model.TotalCapacityUsedPercent"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                </div>

                <div class="d-flex justify-content-between text-muted small fw-bolder mb-4">
                    <span style="font-size: 0.7rem">@Model.TotalCapacityUsedPercent% CAPACITY USED</span>
                    <span style="font-size: 0.7rem">@Model.TotalCapacityFree UNITS FREE</span>
                </div>

                @if (Model.WarehouseCapacities.Any())
                {
                    foreach (var warehouse in Model.WarehouseCapacities)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="fw-bold text-dark small">@warehouse.WarehouseName</span>
                                <span class="fw-bold text-muted small">@warehouse.UsedPercent%</span>
                            </div>

                            <div class="progress bg-white border" style="height: 7px; border-radius: 4px;">
                                <div class="progress-bar @warehouse.CapacityBarClass"
                                     style="width: @warehouse.UsedPercent%; border-radius: 4px;">
                                </div>
                            </div>

                            <div class="text-muted small mt-1">
                                @warehouse.UsedCapacity / @warehouse.Capacity units used
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted fw-bold mb-0">No warehouse capacity data available.</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-xl-6">
        <div class="detail-card border-0 h-100 wms-dashboard-section-card" style="padding: 1.5rem;">
            <div class="d-flex justify-content-between align-items-center mb-4 wms-dashboard-section-header">
                <h6 class="fw-bolder text-uppercase m-0" style="letter-spacing: 0.1em;">Low Stock Products</h6>
                <a asp-controller="Product" asp-action="Index" class="fw-bold text-primary text-decoration-none small">View Products</a>
            </div>

            @if (Model.LowStockProducts.Any())
            {
                foreach (var item in Model.LowStockProducts)
                {
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom wms-dashboard-list-row">
                        <div>
                            <div class="fw-bolder text-dark">@item.ProductName</div>
                            <div class="text-muted small fw-bold">Total quantity: @item.TotalQuantity</div>
                        </div>

                        <span class="wms-badge wms-stock-badge @item.StockBadgeClass">
                            @item.StockText
                        </span>
                    </div>
                }
            }
            else
            {
                <div class="text-muted fw-bold py-4">
                    No low stock products detected.
                </div>
            }
        </div>
    </div>

    <div class="col-xl-6">
        <div class="detail-card border-0 h-100 wms-dashboard-section-card" style="padding: 1.5rem;">
            <div class="d-flex justify-content-between align-items-center mb-4 wms-dashboard-section-header">
                <h6 class="fw-bolder text-uppercase m-0" style="letter-spacing: 0.1em;">Pending Purchase Orders</h6>
                <a asp-controller="PurchaseOrder" asp-action="Index" class="fw-bold text-primary text-decoration-none small">View Orders</a>
            </div>

            @if (Model.PendingPurchaseOrders.Any())
            {
                foreach (var order in Model.PendingPurchaseOrders)
                {
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom gap-3 wms-dashboard-list-row">
                        <div>
                            <div class="fw-bolder text-dark">PO-@order.OrderNumber</div>
                            <div class="text-muted small fw-bold">@order.SupplierName -> @order.WarehouseName</div>
                            <div class="text-muted small">Expected: @order.ExpectedDeliveryDate.ToShortDateString()</div>
                        </div>

                        <span class="wms-badge wms-status-badge @order.StatusBadgeClass">
                            @order.StatusText
                        </span>
                    </div>
                }
            }
            else
            {
                <div class="text-muted fw-bold py-4">
                    No pending purchase orders.
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-12">
        <div class="detail-card border-0 wms-dashboard-section-card" style="padding: 1.5rem;">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 wms-dashboard-quick-actions">
                <div>
                    <h6 class="fw-bolder text-uppercase m-0" style="letter-spacing: 0.1em;">Quick Actions</h6>
                    <div class="text-muted small fw-bold mt-2">Actions are shown based on the current user role.</div>
                </div>

                <div class="d-flex flex-wrap gap-2 wms-dashboard-action-buttons">
                    @if (User.IsInRole("Admin") || User.IsInRole("Operator"))
                    {
                        <a asp-controller="Product" asp-action="Create" class="btn btn-primary rounded-pill fw-bold px-4">
                            Create Product
                        </a>

                        <a asp-controller="PurchaseOrder" asp-action="Create" class="btn btn-outline-primary rounded-pill fw-bold px-4">
                            Create Purchase Order
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Warehouse" asp-action="Create" class="btn btn-outline-danger rounded-pill fw-bold px-4">
                            Create Warehouse
                        </a>
                    }

                    @if (!User.Identity?.IsAuthenticated ?? true || User.IsInRole("Guest"))
                    {
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary rounded-pill fw-bold px-4">
                            Browse Products
                        </a>

                        <a asp-controller="Warehouse" asp-action="Index" class="btn btn-outline-secondary rounded-pill fw-bold px-4">
                            Browse Warehouses
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
