@model IReadOnlyList<WarehouseManagementSystem.Model.PurchaseOrder>

@{
    ViewData["Title"] = "Overdue Purchase Orders";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">PURCHASE ORDERS</a> &gt;
    OVERDUE
</div>

<h1 class="page-title">Overdue Purchase Orders</h1>

<div class="metric-card border-start border-4 border-danger mb-4">
    <div class="text-muted small fw-bold text-uppercase mb-2">
        Delayed Orders
    </div>
    <div class="fs-4 fw-bolder text-danger">
        @(Model?.Count ?? 0) Need Attention
    </div>
</div>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Order Number</th>
                <th>Supplier Information</th>
                <th>Date Issued</th>
                <th>Current Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <partial name="_PurchaseOrderListPartial" model="Model" />
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">
        &larr; Back to Purchase Orders
    </a>
</div>