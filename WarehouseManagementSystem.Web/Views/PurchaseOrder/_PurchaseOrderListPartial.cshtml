@model IReadOnlyList<PurchaseOrder>

@if (Model != null && Model.Any())
{
    foreach (var order in Model)
    {
        <tr>
            <td class="text-primary fw-bolder small">PO-@order.OrderNumber.ToString("0000")</td>
            <td>
                <div class="fw-bolder">@(order.Supplier?.Name ?? "External Sub-vendor")</div>
            </td>
            <td>
                <div class="fw-bold text-dark">@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</div>
            </td>
            <td>
                @{
                    var bgClass = order.Status switch
                    {
                        OrderStatus.Approved => "wms-badge-primary",
                        OrderStatus.Shipped => "wms-badge-info",
                        OrderStatus.Delivered => "wms-badge-success",
                        OrderStatus.Cancelled => "wms-badge-danger",
                        _ => "wms-badge-warning"
                    };
                }
                <span class="badge rounded-pill wms-status-badge @bgClass">@order.Status</span>
            </td>
            <td>
                <a class="action-btn" asp-action="Details" asp-route-id="@order.Id">DETAILS</a>
            </td>
        </tr>
    }
}
else
{
    <tr><td colspan="5" class="text-center py-4 text-muted border-0">No purchase records found.</td></tr>
}
