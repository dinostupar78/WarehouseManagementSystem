@model IReadOnlyList<WarehouseManagementSystem.Model.PurchaseOrder>

@{
    ViewData["Title"] = "Purchase Orders by Supplier";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">PURCHASE ORDERS</a> &gt;
    SUPPLIER
</div>

<h1 class="page-title">Purchase Orders for @ViewBag.SupplierName</h1>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Order Number</th>
                <th>Supplier Information</th>
                <th>Date Issued</th>
                <th>Current Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <partial name="_PurchaseOrderListPartial" model="Model" />
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-controller="Supplier"
       asp-action="Details"
       asp-route-id="@ViewBag.SupplierId"
       class="btn btn-outline-primary px-4 fw-bold rounded-pill">
        Back to Supplier Details
    </a>
</div>
