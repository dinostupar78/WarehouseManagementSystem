@model IReadOnlyList<WarehouseManagementSystem.Model.PurchaseOrder>

@{
    ViewData["Title"] = "Purchase Orders by Status";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">PURCHASE ORDERS</a> &gt;
    STATUS
</div>

<h1 class="page-title">@ViewBag.Status Purchase Orders</h1>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Order Number</th>
                <th>Supplier Information</th>
                <th>Date Issued</th>
                <th>Current Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <partial name="_PurchaseOrderListPartial" model="Model" />
        </tbody>
    </table>
</div>

<partial name="_BackToSourceDetails" />
