@model IReadOnlyList<WarehouseManagementSystem.Model.PurchaseOrder>
@{
    ViewData["Title"] = $"Purchase Orders - {ViewBag.Status}";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">PURCHASE ORDERS</a> &gt; 
    @ViewBag.Status
</div>
<h1 class="page-title">Purchase Orders - @ViewBag.Status</h1>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="metric-card border-start border-4 border-primary">
            <div class="text-muted small fw-bold text-uppercase mb-2">Total Orders</div>
            <div class="fs-4 fw-bolder text-primary">@(Model?.Count ?? 0) matching orders</div>
        </div>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-secondary">No purchase orders found with status @ViewBag.Status.</div>
}
else
{
    <div class="wms-table-container">
        <table class="table wms-table table-hover">
            <thead>
                <tr>
                    <th>Order Number</th>
                    <th>Supplier</th>
                    <th>Date Issued</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="text-primary fw-bolder small">PO-@order.OrderNumber.ToString("0000")</td>
                        <td>
                            <div class="fw-bolder">@(order.Supplier?.Name ?? "External Supplier")</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@order.OrderDate.ToString("MMM dd, yyyy")</div>
                        </td>
                        <td>
                            @{
                                var bgClass = order.Status switch
                                {
                                    OrderStatus.Approved => "wms-badge-primary",
                                    OrderStatus.Shipped => "wms-badge-info",
                                    OrderStatus.Delivered => "wms-badge-success",
                                    OrderStatus.Cancelled => "wms-badge-danger",
                                    _ => "wms-badge-warning"
                                };
                            }
                            <span class="badge rounded-pill wms-status-badge @bgClass">@order.Status</span>
                        </td>
                        <td>
                            <a class="action-btn" asp-action="Details" asp-route-id="@order.Id">DETAILS</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-5">
    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">&larr; Back to Purchase Orders</a>
</div>
