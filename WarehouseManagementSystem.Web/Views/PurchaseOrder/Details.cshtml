@model WarehouseManagementSystem.Model.PurchaseOrder
@{
    ViewData["Title"] = "Purchase Order Details";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">PURCHASE ORDERS</a> &gt; 
    PO-@Model?.OrderNumber.ToString("0000")
</div>
<h1 class="page-title">Order Info PO-@Model?.OrderNumber.ToString("0000")</h1>

@if (Model == null)
{
    <div class="alert alert-secondary">Order not found.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/></svg>
                    </div>
                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted">Purchase Receipt</h5>
                        <h4 class="fw-bolder">@(Model.Supplier?.Name ?? "External Supplier")</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Order Number</div>
                        <div class="fw-bolder text-primary fs-5">PO-@Model.OrderNumber.ToString("0000")</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Order Date</div>
                        <div class="fw-bolder text-dark">@Model.OrderDate.ToString("MMMM dd, yyyy")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3">Execution Status</h5>
                <div class="mb-4">
                    <div class="text-muted small fw-bold text-uppercase">Current Resolution</div>
                    @{
                        var statusBadgeClass = Model.Status switch
                        {
                            OrderStatus.Approved => "wms-badge-primary",
                            OrderStatus.Shipped => "wms-badge-info",
                            OrderStatus.Delivered => "wms-badge-success",
                            OrderStatus.Cancelled => "wms-badge-danger",
                            _ => "wms-badge-warning"
                        };
                    }
                    <span class="badge rounded-pill wms-status-badge @statusBadgeClass">
                        @Model.Status
                    </span>
                    
                    <div class="text-muted small fw-bold text-uppercase mt-3">Target Warehouse</div>
                    <div class="fw-bolder text-dark">@(Model.Warehouse?.Name ?? "Pending Allocation")</div>
                </div>
            </div>
        </div>
    </div>
}

@if (Model != null)
{
    <div class="wms-detail-actions mt-5">
        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Record actions</div>
                <div class="fw-bolder">Manage this purchase order</div>
            </div>

            <div class="wms-detail-action-buttons">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary px-4 fw-bold rounded-pill">
                    Edit Purchase Order
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger px-4 fw-bold rounded-pill">
                    Delete Purchase Order
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Related PO Views</div>
                <div class="fw-bolder">Explore related purchase orders</div>
            </div>

            <div class="wms-related-actions">
                <a asp-action="FindByOrderStatus"
                   asp-route-status="@Model.Status.ToString().ToLower()"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Status</span>
                    <span>@Model.Status orders</span>
                </a>

                <a asp-action="BySupplier"
                   asp-route-supplierId="@Model.SupplierId"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Supplier</span>
                    <span>Orders from @(Model.Supplier?.Name)</span>
                </a>

                <a asp-action="Overdue"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Delivery risk</span>
                    <span>Overdue orders</span>
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group wms-detail-navigation-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Navigation</div>
                <div class="fw-bolder">Return to order book</div>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4 fw-bold rounded-pill wms-detail-back-link">
                &larr; Back to Order Book
            </a>
        </div>
    </div>
}
