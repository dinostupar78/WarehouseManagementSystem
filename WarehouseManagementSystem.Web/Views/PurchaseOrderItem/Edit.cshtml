@using WarehouseManagementSystem.Web.Models

@model WarehouseManagementSystem.Model.PurchaseOrderItem

@{
    ViewData["Title"] = "Edit Purchase Order Item";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">PO ITEMS</a> &gt;
    <a asp-action="Details" asp-route-id="@Model.Id">POI-@Model.Id.ToString("0000")</a> &gt;
    Edit
</div>

<h1 class="page-title">Edit PO Item POI-@Model.Id.ToString("0000")</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2.5 1A1.5 1.5 0 0 0 1 2.5v11A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 13.5 1h-11zM2 2.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 .5.5v11a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11z" />
                            <path d="M5.5 4a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5zm0 3a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5zm0 3a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5z" />
                        </svg>
                    </div>

                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                            Item Data
                        </h5>
                        <h4 class="fw-bolder">@(Model.Product?.Name ?? "Unknown Product")</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">
                            Tracking Code
                        </div>
                        <div class="fw-bolder text-primary fs-5">
                            POI-@Model.Id.ToString("0000")
                        </div>
                    </div>

                    <div class="col-sm-6 mb-3">
                        @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownModel
                        {
                            FieldName = "PurchaseOrderId",
                            Label = "Purchase Order",
                            Prefix = "PO",
                            SearchUrl = Url.Action("Autocomplete", "PurchaseOrder") ?? "/purchase-orders/autocomplete",
                            Placeholder = "Search order by number, supplier or status...",
                            SelectedValue = Model.PurchaseOrderId > 0 ? Model.PurchaseOrderId.ToString() : string.Empty,
                            SelectedText = Model.PurchaseOrder != null ? $"PO-{Model.PurchaseOrder.OrderNumber:0000}" : null
                        })
                    </div>

                    <div class="col-md-12 mb-3">
                        @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownModel
                        {
                            FieldName = "ProductId",
                            Label = "Product",
                            Prefix = "PRD",
                            SearchUrl = Url.Action("Autocomplete", "Product") ?? "/products/autocomplete",
                            Placeholder = "Search product by name...",
                            SelectedValue = Model.ProductId > 0 ? Model.ProductId.ToString() : string.Empty,
                            SelectedText = Model.Product?.Name
                        })
                    </div>

                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">
                            Current Product
                        </div>
                        <div class="fw-bolder text-dark">
                            @(Model.Product?.Name ?? "Unknown Product")
                        </div>
                    </div>

                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">
                            Current Linked Order
                        </div>
                        <div class="fw-bolder text-dark">
                            PO-@((Model.PurchaseOrder?.OrderNumber ?? Model.PurchaseOrderId).ToString("0000"))
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                    Financial Allocation
                </h5>

                <div class="mb-4">
                    <label asp-for="Quantity" class="form-label text-muted small fw-bold text-uppercase">
                        Quantity
                    </label>

                    <div class="input-group">
                        <input asp-for="Quantity"
                               class="form-control rounded-start-pill px-4 fs-4 fw-bolder text-dark" />
                        <span class="input-group-text rounded-end-pill fw-bold text-muted">Units</span>
                    </div>

                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="UnitPrice" class="form-label text-muted small fw-bold text-uppercase">
                        Unit Price
                    </label>

                    <div class="input-group">
                        <span class="input-group-text rounded-start-pill fw-bold text-muted">€</span>
                        <input asp-for="UnitPrice"
                               class="form-control rounded-end-pill px-4 fw-bolder text-info" />
                    </div>

                    <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                </div>

                <div class="text-muted small fw-bold text-uppercase mt-3">
                    Subtotal
                </div>

                <div class="fw-bolder text-success fs-3">
                    @((Model.Quantity * Model.UnitPrice).ToString("C"))
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 d-flex flex-wrap gap-3">
        <button type="submit" class="btn btn-primary px-4 fw-bold rounded-pill">
            Save Changes
        </button>

        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary px-4 fw-bold rounded-pill">
            View Details
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">
            &larr; Back to Items List
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
