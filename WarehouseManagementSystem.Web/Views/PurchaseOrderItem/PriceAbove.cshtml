@model IReadOnlyList<WarehouseManagementSystem.Model.PurchaseOrderItem>

@{
    ViewData["Title"] = "Items by Unit Price";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">PO ITEMS</a> &gt;
    PRICE ABOVE
</div>

<h1 class="page-title">Items with Unit Price Above @ViewBag.MinPrice.ToString("C")</h1>

<div class="metric-card border-start border-4 border-warning mb-4">
    <div class="text-muted small fw-bold text-uppercase mb-2">
        Minimum Unit Price
    </div>
    <div class="fs-4 fw-bolder text-warning">
        @ViewBag.MinPrice.ToString("C")
    </div>
</div>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Item ID</th>
                <th>Product</th>
                <th>Purchase Order</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <partial name="_PurchaseOrderItemListPartial" model="Model" />
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">
        &larr; Back to PO Items
    </a>
</div>