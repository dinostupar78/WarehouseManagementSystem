@model IReadOnlyList<WarehouseManagementSystem.Model.PurchaseOrderItem>

@{
    ViewData["Title"] = "Items by Purchase Order";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">PO ITEMS</a> &gt;
    PURCHASE ORDER
</div>

<h1 class="page-title">Items for PO-@ViewBag.OrderNumber.ToString("0000")</h1>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Item ID</th>
                <th>Product</th>
                <th>Purchase Order</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <partial name="_PurchaseOrderItemListPartial" model="Model" />
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-controller="PurchaseOrder"
       asp-action="Details"
       asp-route-id="@ViewBag.PurchaseOrderId"
       class="btn btn-outline-primary px-4 fw-bold rounded-pill">
        Back to Purchase Order Details
    </a>
</div>
