@model IReadOnlyList<WarehouseManagementSystem.Model.PurchaseOrderItem>
@{
    ViewData["Title"] = "Purchase Order PurchaseOrderItems";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; PO ITEMS
</div>
<h1 class="page-title">Order Items List</h1>

<div class="mb-4 d-flex justify-content-end">
    <a asp-action="Create"
       class="btn btn-primary px-4 py-3 fw-bold rounded-pill shadow-sm">
        + Create Purchase Order Item
    </a>
</div>

<div class="mb-3">
    <input id="purchaseOrderItem-search"
           class="form-control rounded-pill px-4"
           data-ajax-search
           data-search-url="/purchase-order-items/search"
           data-target="#purchaseOrderItem-table-body"
           placeholder="Search purchase order items by quantity, unit price, purchase order or product..." />
</div>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Item ID</th>
                <th>Product</th>
                <th>Purchase Order</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="purchaseOrderItem-table-body">
            <partial name="_PurchaseOrderItemListPartial" model="Model" />
        </tbody>
    </table>
</div>

