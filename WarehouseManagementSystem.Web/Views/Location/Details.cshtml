@model WarehouseManagementSystem.Models.Location
@{
    ViewData["Title"] = "Location Details";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">LOCATIONS</a> &gt; 
    @Model?.Code
</div>
<h1 class="page-title">Location @Model?.Code</h1>

@if (Model == null)
{
    <div class="alert alert-secondary">Location not found.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/></svg>
                    </div>
                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted">Infrastructure Data</h5>
                        <h4 class="fw-bolder">@Model.Code</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Zone Assignment</div>
                        <div class="fw-bolder text-primary fs-5">@Model.Zone.ToUpper()</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Shelf Reference</div>
                        <div class="fw-bolder text-dark">@Model.ShelfNumber</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3">Parent Allocation</h5>
                <div class="mb-4">
                    <div class="text-muted small fw-bold text-uppercase">Warehouse Facility</div>
                    <div class="fs-4 fw-bolder text-info">@(Model.Warehouse?.Name ?? "Unassigned")</div>
                    
                    <div class="text-muted small fw-bold text-uppercase mt-3">Internal Warehouse ID</div>
                    <div class="fw-bolder text-dark">ID: @Model.WarehouseId</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="mt-5">
    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">&larr; Back to Allocations</a>
</div>