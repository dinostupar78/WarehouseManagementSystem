@model WarehouseManagementSystem.Model.Location
@{
    ViewData["Title"] = "Location Details";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">LOCATIONS</a> &gt; 
    @Model?.Code
</div>
<h1 class="page-title">Location @Model?.Code</h1>

@if (Model == null)
{
    <div class="alert alert-secondary">Location not found.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/></svg>
                    </div>
                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted">Infrastructure Data</h5>
                        <h4 class="fw-bolder">@Model.Code</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Zone Assignment</div>
                        <div class="fw-bolder text-primary fs-5">@Model.Zone.ToUpper()</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Shelf Reference</div>
                        <div class="fw-bolder text-dark">@Model.ShelfNumber</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3">Parent Allocation</h5>
                <div class="mb-4">
                    <div class="text-muted small fw-bold text-uppercase">Warehouse Facility</div>
                    <div class="fs-4 fw-bolder text-info">@(Model.Warehouse?.Name ?? "Unassigned")</div>
                    
                    <div class="text-muted small fw-bold text-uppercase mt-3">Internal Warehouse ID</div>
                    <div class="fw-bolder text-dark">ID: @Model.WarehouseId</div>
                </div>
            </div>
        </div>
    </div>
}

@if (Model != null)
{
    <div class="wms-detail-actions mt-5">
        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Record actions</div>
                <div class="fw-bolder">Manage this location</div>
            </div>

            <div class="wms-detail-action-buttons">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary px-4 fw-bold rounded-pill">
                    Edit Location
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger px-4 fw-bold rounded-pill">
                    Delete Location
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Related Location Views</div>
                <div class="fw-bolder">Explore related locations</div>
            </div>

            <div class="wms-related-actions">
                <a asp-action="ByZone"
                   asp-route-zone="@Model.Zone"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Same Zone</span>
                    <span>Zone @Model.Zone.ToUpper()</span>
                </a>

                <a asp-action="ByWarehouse"
                   asp-route-warehouseId="@Model.WarehouseId"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Same Warehouse</span>
                    <span>Locations in @(Model.Warehouse?.Name)</span>
                </a>

                <a asp-action="ShelfAbove"
                   asp-route-shelfNumber="@Model.ShelfNumber"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Shelf Filter</span>
                    <span>Shelf @Model.ShelfNumber or above</span>
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group wms-detail-navigation-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Navigation</div>
                <div class="fw-bolder">Return to location list</div>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4 fw-bold rounded-pill wms-detail-back-link">
                &larr; Back to Allocations
            </a>
        </div>
    </div>
}
