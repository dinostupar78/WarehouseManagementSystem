@model IReadOnlyList<WarehouseManagementSystem.Model.Location>

@{
    ViewData["Title"] = "Locations by Warehouse";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">LOCATIONS</a> &gt;
    WAREHOUSE
</div>

<h1 class="page-title">Locations in @ViewBag.WarehouseName</h1>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Location ID</th>
                <th>Internal Code</th>
                <th>Assigned Warehouse</th>
                <th>Current Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <partial name="_LocationListPartial" model="Model" />
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-controller="Warehouse"
       asp-action="Details"
       asp-route-id="@ViewBag.WarehouseId"
       class="btn btn-outline-primary px-4 fw-bold rounded-pill">
        Back to Warehouse Details
    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary px-4 fw-bold rounded-pill ms-2">
        &larr; Back to Locations
    </a>
</div>