@model WarehouseManagementSystem.Model.Warehouse
@{
    ViewData["Title"] = "Warehouse Details";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">WAREHOUSES</a> &gt; 
    @Model?.Name
</div>
<h1 class="page-title">Warehouse @Model?.Name</h1>

@if (Model == null)
{
    <div class="alert alert-secondary">Warehouse not found.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" class="bi bi-building" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.629V5.5a.5.5 0 0 1 .342-.474l4-1.5A.5.5 0 0 1 10.5 4h.5V1.5A.5.5 0 0 1 11.237.07l3.5-1zM2 11h3v4H2v-4zm4-4h3v8H6V7zm4-4h3v12h-3V3z"/>
                        </svg>
                    </div>
                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted" style="letter-spacing: 0.1em; font-size: 0.8rem;">Warehouse Fundamentals</h5>
                        <h4 class="fw-bolder">@Model.Name</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Unique Identifier</div>
                        <div class="fw-bolder text-primary fs-5">WH-NORD-@Model.Id.ToString("0000")</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Physical Address</div>
                        <div class="fw-bolder">@Model.Address</div>
                        <div class="small text-muted">@Model.City, @Model.Country</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3" style="letter-spacing: 0.1em; font-size: 0.8rem;">Storage Metrics</h5>
                <div class="mb-4">
                    <div class="text-muted small fw-bold text-uppercase">Total Capacity</div>
                    <div class="fs-1 fw-bolder text-info">@Model.Capacity <span class="fs-6 text-muted ms-1">Units</span></div>
                </div>
                <div class="progress mb-2" style="height: 10px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: 72%" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="small text-muted fw-bold">72% Utilization Efficiency</div>
            </div>
        </div>
    </div>
}

@if (Model != null)
{
    <div class="wms-detail-actions mt-5">
        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Record actions</div>
                <div class="fw-bolder">Manage this warehouse</div>
            </div>

            <div class="wms-detail-action-buttons">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary px-4 fw-bold rounded-pill">
                    Edit Warehouse
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger px-4 fw-bold rounded-pill">
                    Delete Warehouse
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Related Warehouse Views</div>
                <div class="fw-bolder">Explore related warehouses</div>
            </div>

            <div class="wms-related-actions">
                <a asp-action="FindByCity"
                   asp-route-city="@Model.City"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Same city</span>
                    <span>Warehouses in @Model.City</span>
                </a>

                <a asp-action="FindByCountry"
                   asp-route-country="@Model.Country"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Same country</span>
                    <span>Warehouses in @Model.Country</span>
                </a>

                <a asp-action="CapacityAbove"
                   asp-route-capacity="@Model.Capacity"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Capacity</span>
                    <span>Above @Model.Capacity units</span>
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group wms-detail-navigation-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Navigation</div>
                <div class="fw-bolder">Return to warehouse list</div>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4 fw-bold rounded-pill wms-detail-back-link">
                &larr; Back to Active Warehouses
            </a>
        </div>
    </div>
}
