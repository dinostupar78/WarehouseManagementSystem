@model IReadOnlyList<WarehouseManagementSystem.Model.Warehouse>
@{
    ViewData["Title"] = $"Warehouses in {ViewBag.Country}";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">WAREHOUSES</a> &gt; 
    Warehouses in @ViewBag.Country
</div>
<h1 class="page-title">Warehouses in @ViewBag.Country</h1>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-secondary">No warehouses found in @ViewBag.Country.</div>
}
else
{
    <div class="wms-table-container">
        <table class="table wms-table table-hover">
            <thead>
                <tr>
                    <th>Warehouse ID</th>
                    <th>Warehouse Name</th>
                    <th>City / Country</th>
                    <th>Capacity Usage</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var warehouse in Model)
                {
                    <tr>
                        <td class="text-primary fw-bolder small">WH-@warehouse.Id.ToString("0000")</td>
                        <td>
                            <div class="fw-bolder">@warehouse.Name</div>
                            <div class="small text-muted">@warehouse.Address</div>
                        </td>
                        <td>
                            <div class="fw-bold">@warehouse.City</div>
                            <div class="small text-muted">@warehouse.Country</div>
                        </td>
                        <td>
                            <div class="fw-bold">@warehouse.Capacity</div>
                            <small class="text-muted">Total Units</small>
                        </td>
                        <td>
                            <a class="action-btn" asp-action="Details" asp-route-id="@warehouse.Id">DETAILS</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_BackToSourceDetails" />
