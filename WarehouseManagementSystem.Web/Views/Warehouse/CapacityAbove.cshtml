@model IReadOnlyList<WarehouseManagementSystem.Model.Warehouse>
@{
    ViewData["Title"] = $"Warehouses with Capacity Above {ViewBag.MinCapacity}";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">WAREHOUSES</a> &gt; 
    Capacity Above @ViewBag.MinCapacity
</div>
<h1 class="page-title">Warehouses with Capacity Above @ViewBag.MinCapacity</h1>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="metric-card border-start border-4 border-primary">
            <div class="text-muted small fw-bold text-uppercase mb-2">Total Warehouses</div>
            <div class="fs-4 fw-bolder text-primary">@(Model?.Count ?? 0) Active Units</div>
        </div>
    </div>
</div>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-secondary">No warehouses found with capacity above @ViewBag.MinCapacity.</div>
}
else
{
    <div class="wms-table-container">
        <table class="table wms-table table-hover">
            <thead>
                <tr>
                    <th>Warehouse ID</th>
                    <th>Warehouse Name</th>
                    <th>City / Country</th>
                    <th>Capacity Usage</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var warehouse in Model)
                {
                    <tr>
                        <td class="text-primary fw-bolder small">WH-@warehouse.Id.ToString("0000")</td>
                        <td>
                            <div class="fw-bolder">@warehouse.Name</div>
                            <div class="small text-muted">@warehouse.Address</div>
                        </td>
                        <td>
                            <div class="fw-bold">@warehouse.City</div>
                            <div class="small text-muted">@warehouse.Country</div>
                        </td>
                        <td>
                            <div class="fw-bold">@warehouse.Capacity</div>
                            <small class="text-muted">Total Units</small>
                        </td>
                        <td>
                            <a class="action-btn" asp-action="Details" asp-route-id="@warehouse.Id">DETAILS</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-5">
    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">&larr; Back to Active Warehouses</a>
</div>