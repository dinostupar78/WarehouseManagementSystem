@model WarehouseManagementSystem.Model.Warehouse

@{
    ViewData["Title"] = "Create Warehouse";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">WAREHOUSES</a> &gt;
    Create
</div>

<h1 class="page-title">Create Warehouse</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" class="bi bi-building" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.629V5.5a.5.5 0 0 1 .342-.474l4-1.5A.5.5 0 0 1 10.5 4h.5V1.5A.5.5 0 0 1 11.237.07l3.5-1zM2 11h3v4H2v-4zm4-4h3v8H6V7zm4-4h3v12h-3V3z" />
                        </svg>
                    </div>

                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                            Warehouse Fundamentals
                        </h5>
                        <h4 class="fw-bolder">New Warehouse</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-md-12 mb-3">
                        <label asp-for="Name" class="form-label text-muted small fw-bold text-uppercase"></label>
                        <input asp-for="Name" class="form-control rounded-pill px-4" placeholder="Enter warehouse name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="Address" class="form-label text-muted small fw-bold text-uppercase"></label>
                        <input asp-for="Address" class="form-control rounded-pill px-4" placeholder="Enter physical address" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="col-sm-6 mb-3">
                        <label asp-for="City" class="form-label text-muted small fw-bold text-uppercase"></label>
                        <input asp-for="City" class="form-control rounded-pill px-4" placeholder="Enter city" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>

                    <div class="col-sm-6 mb-3">
                        <label asp-for="Country" class="form-label text-muted small fw-bold text-uppercase"></label>
                        <input asp-for="Country" class="form-control rounded-pill px-4" placeholder="Enter country" />
                        <span asp-validation-for="Country" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                    Storage Metrics
                </h5>

                <div class="mb-4">
                    <label asp-for="Capacity" class="form-label text-muted small fw-bold text-uppercase"></label>
                    <div class="input-group">
                        <input asp-for="Capacity" class="form-control rounded-start-pill px-4 fs-4 fw-bolder text-info" placeholder="0" />
                        <span class="input-group-text rounded-end-pill fw-bold text-muted">Units</span>
                    </div>
                    <span asp-validation-for="Capacity" class="text-danger small"></span>
                </div>

                <div class="progress mb-2" style="height: 10px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="small text-muted fw-bold">
                    Utilization will be calculated after warehouse setup
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5">
        <button type="submit" class="btn btn-primary px-4 fw-bold rounded-pill me-3">
            Create Warehouse
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">
            &larr; Back to Active Warehouses
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}