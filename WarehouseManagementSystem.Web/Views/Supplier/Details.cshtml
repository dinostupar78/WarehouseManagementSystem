@model WarehouseManagementSystem.Model.Supplier
@{
    ViewData["Title"] = "Supplier Details";
}

@{
    var emailDomain = Model.ContactEmail?.Contains("@") == true
        ? Model.ContactEmail.Split('@').Last()
        : "";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">SUPPLIERS</a> &gt; 
    @Model?.Name
</div>
<h1 class="page-title">Supplier @Model?.Name</h1>

@if (Model == null)
{
    <div class="alert alert-secondary">Supplier not found.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/></svg>
                    </div>
                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted">Vendor Data</h5>
                        <h4 class="fw-bolder">@Model.Name</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Registration ID</div>
                        <div class="fw-bolder text-primary fs-5">VND-@Model.Id.ToString("0000")</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Primary Contact</div>
                        <div class="fw-bolder text-dark">@Model.ContactPerson</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3">Contact Information</h5>
                <div class="mb-4">
                    <div class="text-muted small fw-bold text-uppercase">Email Address</div>
                    <div class="fw-bolder text-info">@Model.ContactEmail</div>
                    
                    <div class="text-muted small fw-bold text-uppercase mt-3">Phone Line</div>
                    <div class="fw-bolder text-dark">@Model.ContactPhone</div>

                    <div class="text-muted small fw-bold text-uppercase mt-3">Contact Address</div>
                    <div class="fw-bolder text-dark">@Model.ContactAddress</div>
                </div>
            </div>
        </div>
    </div>
}

@if (Model != null)
{
    <div class="wms-detail-actions mt-5">
        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Record actions</div>
                <div class="fw-bolder">Manage this supplier</div>
            </div>

            <div class="wms-detail-action-buttons">
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary px-4 fw-bold rounded-pill">
                    Edit Supplier
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-danger px-4 fw-bold rounded-pill">
                    Delete Supplier
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Related Supplier Views</div>
                <div class="fw-bolder">Explore related supplier records</div>
            </div>

            <div class="wms-related-actions">
                @if (!string.IsNullOrWhiteSpace(emailDomain))
                {
                    <a asp-action="ByEmailDomain"
                       asp-route-domain="@emailDomain"
                       asp-route-sourceId="@Model.Id"
                       class="wms-related-action-link">
                        <span class="wms-related-action-label">Email Domain</span>
                        <span>Suppliers using @emailDomain</span>
                    </a>
                }

                <a asp-action="WithPurchaseOrders"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Active Suppliers</span>
                    <span>With purchase orders</span>
                </a>

                <a asp-action="WithoutPurchaseOrders"
                   asp-route-sourceId="@Model.Id"
                   class="wms-related-action-link">
                    <span class="wms-related-action-label">Unused Suppliers</span>
                    <span>Without purchase orders</span>
                </a>
            </div>
        </div>

        <div class="wms-detail-action-group wms-detail-navigation-group">
            <div class="wms-detail-action-heading">
                <div class="text-muted small fw-bold text-uppercase">Navigation</div>
                <div class="fw-bolder">Return to supplier list</div>
            </div>

            <a asp-action="Index"
               class="btn btn-outline-secondary px-4 fw-bold rounded-pill wms-detail-back-link">
                &larr; Back to Suppliers
            </a>
        </div>
    </div>
}
