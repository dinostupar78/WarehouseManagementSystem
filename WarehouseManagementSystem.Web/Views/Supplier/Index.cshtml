@model IReadOnlyList<Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; SUPPLIERS
</div>
<h1 class="page-title">Suppliers Registry</h1>

<div class="row mb-4 align-items-stretch wms-index-metric-row">
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card border-start border-4 border-primary h-100 p-3">
            <div class="text-muted small fw-bold text-uppercase mb-2">
                Total Suppliers
            </div>
            <div class="fs-4 fw-bolder text-primary">
                @ViewBag.TotalSuppliers Active Vendors
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="metric-card border-start border-4 border-info h-100 p-3">
            <div class="text-muted small fw-bold text-uppercase mb-2">
                Email Contacts
            </div>
            <div class="fs-4 fw-bolder text-info">
                @ViewBag.SuppliersWithEmail Available
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="metric-card border-start border-4 border-warning h-100 p-3">
            <div class="text-muted small fw-bold text-uppercase mb-2">
                Address Records
            </div>
            <div class="fs-4 fw-bolder text-warning">
                @ViewBag.SuppliersWithAddress Stored
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3 d-flex justify-content-xl-end align-items-center wms-index-create">
        <a asp-action="Create"
           class="btn btn-primary px-4 py-3 fw-bold rounded-pill shadow-sm wms-index-create-button">
            + Create Supplier Item
        </a>
    </div>
</div>

<div class="wms-list-search-panel mb-3">
    <div class="wms-list-search-header">
        <div>
            <div class="text-muted small fw-bold text-uppercase">Supplier List</div>
            <div class="fw-bolder">Search supplier records</div>
        </div>
    </div>

    <div class="wms-list-search-field">
        <input id="supplier-search"
               class="form-control rounded-pill"
               data-ajax-search
               data-search-url="/suppliers/search"
               data-target="#supplier-table-body"
               placeholder="Search suppliers by name, contact person, email, phone or address..." />

        <span class="wms-list-search-icon" aria-hidden="true">
            <svg width="20"
                 height="20"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
        </span>
    </div>
</div>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Registration ID</th>
                <th>Supplier Name</th>
                <th>Primary Contact</th>
                <th>Email Address</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="supplier-table-body">
            <partial name="_SupplierListPartial" model="Model" />
        </tbody>
    </table>
</div>

