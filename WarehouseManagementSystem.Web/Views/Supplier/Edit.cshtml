@model WarehouseManagementSystem.Model.Supplier

@{
    ViewData["Title"] = "Edit Supplier";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">SUPPLIERS</a> &gt;
    <a asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a> &gt;
    Edit
</div>

<h1 class="page-title">Edit Supplier @Model.Name</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5" />
                        </svg>
                    </div>

                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                            Vendor Data
                        </h5>
                        <h4 class="fw-bolder">@Model.Name</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">
                            Registration ID
                        </div>
                        <div class="fw-bolder text-primary fs-5">
                            VND-@Model.Id.ToString("0000")
                        </div>
                    </div>

                    <div class="col-sm-6 mb-3">
                        <label asp-for="Name" class="form-label text-muted small fw-bold text-uppercase"></label>
                        <input asp-for="Name"
                               class="form-control rounded-pill px-4" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12 mb-3">
                        <label asp-for="ContactPerson" class="form-label text-muted small fw-bold text-uppercase">
                            Primary Contact
                        </label>
                        <input asp-for="ContactPerson"
                               class="form-control rounded-pill px-4" />
                        <span asp-validation-for="ContactPerson" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                    Contact Information
                </h5>

                <div class="mb-4">
                    <label asp-for="ContactEmail" class="form-label text-muted small fw-bold text-uppercase">
                        Email Address
                    </label>

                    <input asp-for="ContactEmail"
                           type="email"
                           class="form-control rounded-pill px-4 fw-bolder text-info" />

                    <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ContactPhone" class="form-label text-muted small fw-bold text-uppercase">
                        Phone Line
                    </label>

                    <input asp-for="ContactPhone"
                           type="tel"
                           class="form-control rounded-pill px-4 fw-bolder" />

                    <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ContactAddress" class="form-label text-muted small fw-bold text-uppercase">
                        Contact Address
                    </label>

                    <input asp-for="ContactAddress"
                           class="form-control rounded-pill px-4 fw-bolder" />

                    <span asp-validation-for="ContactAddress" class="text-danger small"></span>
                </div>

                <div class="small text-muted fw-bold">
                    Update supplier contact details used by purchasing and inventory teams.
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 d-flex flex-wrap gap-3">
        <button type="submit" class="btn btn-primary px-4 fw-bold rounded-pill">
            Save Changes
        </button>

        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary px-4 fw-bold rounded-pill">
            View Details
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">
            &larr; Back to Suppliers
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
