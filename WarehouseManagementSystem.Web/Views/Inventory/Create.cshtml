@using WarehouseManagementSystem.Web.Models

@model WarehouseManagementSystem.Model.Inventory

@{
    ViewData["Title"] = "Create Inventory Item";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">INVENTORY</a> &gt;
    Create
</div>

<h1 class="page-title">Create Inventory Item</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923z" />
                        </svg>
                    </div>

                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                            Inventory Fundamentals
                        </h5>
                        <h4 class="fw-bolder">New Inventory Item</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <label class="form-label text-muted small fw-bold text-uppercase">
                            Tracking ID
                        </label>
                        <div class="fw-bolder text-primary fs-5 mt-2">
                            #INV-NEW
                        </div>
                    </div>

                    <div class="col-sm-6 mb-3">
                        @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownModel
                        {
                            FieldName = "ProductId",
                            Label = "Product",
                            Prefix = "PRD",
                            SearchUrl = Url.Action("Autocomplete", "Product") ?? "/products/autocomplete",
                            Placeholder = "Search product by name...",
                            SelectedValue = Model != null && Model.ProductId > 0 ? Model.ProductId.ToString() : string.Empty,
                            SelectedText = Model?.Product?.Name
                        })
                    </div>

                    <div class="col-sm-6 mb-3">
                        @await Html.PartialAsync("_AutocompleteDropdown", new AutocompleteDropdownModel
                        {
                            FieldName = "LocationId",
                            Label = "Location",
                            Prefix = "LOC",
                            SearchUrl = Url.Action("Autocomplete", "Location") ?? "/locations/autocomplete",
                            Placeholder = "Search location by code, zone or warehouse...",
                            SelectedValue = Model != null && Model.LocationId > 0 ? Model.LocationId.ToString() : string.Empty,
                            SelectedText = Model?.Location?.Code
                        })
                    </div>

                    <div class="col-sm-6 mb-3">
                        @await Html.PartialAsync("_DateTimePicker", new DateTimePickerModel
                        {
                            FieldName = "LastUpdated",
                            Label = "Last Updated",
                            Value = Model?.LastUpdated
                        })
                    </div>
                </div>

                <div class="alert alert-secondary small fw-bold mt-3 mb-0 rounded-4">
                    Assign this inventory item to an existing product and location by searching and selecting them from the dropdowns.
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3" style="letter-spacing: 0.1em; font-size: 0.8rem;">
                    Stock Metrics
                </h5>

                <div class="mb-4">
                    <label asp-for="Quantity" class="form-label text-muted small fw-bold text-uppercase">
                        Current Quantity
                    </label>

                    <div class="input-group">
                        <input asp-for="Quantity"
                               class="form-control rounded-start-pill px-4 fs-1 fw-bolder text-info"
                               placeholder="0"
                               data-stock-input />
                        <span class="input-group-text rounded-end-pill fw-bold text-muted">Units</span>
                    </div>

                    <span asp-validation-for="Quantity" class="text-danger small"></span>

                    <div class="mt-3 d-flex flex-wrap align-items-center gap-2">
                        <span class="badge rounded-pill wms-stock-badge" data-stock-preview>
                            OUT OF STOCK
                        </span>
                        <span class="small text-muted fw-bold" data-stock-units>
                            @(Model?.Quantity ?? 0) Units
                        </span>
                    </div>
                </div>

                <div class="small text-muted fw-bold">
                    Stock quantity will be saved as the current inventory amount.
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 d-flex flex-wrap gap-3">
        <button type="submit" class="btn btn-primary px-4 fw-bold rounded-pill">
            Create Inventory Item
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">
            &larr; Back to Active Index
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
