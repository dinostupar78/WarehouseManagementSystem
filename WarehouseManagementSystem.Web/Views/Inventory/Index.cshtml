@model IReadOnlyList<Inventory>
@{
    ViewData["Title"] = "Inventory";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; INVENTORY
</div>
<h1 class="page-title">Inventory Control</h1>

<div class="row mb-4 align-items-stretch wms-index-metric-row">
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card border-start border-4 border-primary h-100 p-3">
            <div class="text-muted small fw-bold text-uppercase mb-2">
                Inventory Records
            </div>
            <div class="fs-4 fw-bolder text-primary">
                @ViewBag.TotalInventoryItems Active Items
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="metric-card border-start border-4 border-info h-100 p-3">
            <div class="text-muted small fw-bold text-uppercase mb-2">
                Total Stock Units
            </div>
            <div class="fs-4 fw-bolder text-info">
                @ViewBag.TotalStockUnits Units
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="metric-card border-start border-4 border-warning h-100 p-3">
            <div class="text-muted small fw-bold text-uppercase mb-2">
                Low Stock Items
            </div>
            <div class="fs-4 fw-bolder text-warning">
                @ViewBag.LowStockItems Alerts
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3 d-flex justify-content-xl-end align-items-center wms-index-create">
        <a asp-action="Create"
           class="btn btn-primary px-4 py-3 fw-bold rounded-pill shadow-sm wms-index-create-button">
            + Create Inventory Item
        </a>
    </div>
</div>

<div class="wms-list-search-panel mb-3">
    <div class="wms-list-search-header">
        <div>
            <div class="text-muted small fw-bold text-uppercase">Inventory List</div>
            <div class="fw-bolder">Search inventory records</div>
        </div>
    </div>

    <div class="wms-list-search-field">
        <input id="inventory-search"
               class="form-control rounded-pill"
               data-ajax-search
               data-search-url="/inventories/search"
               data-target="#inventory-table-body"
               placeholder="Search inventory by product name, location, or quantity..." />

        <span class="wms-list-search-icon" aria-hidden="true">
            <svg width="20"
                 height="20"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
        </span>
    </div>
</div>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Item ID</th>
                <th>Product Information</th>
                <th>Location Details</th>
                <th>Stock / Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="inventory-table-body">
            <partial name="_InventoryListPartial" model="Model" />
        </tbody>
    </table>
</div>

