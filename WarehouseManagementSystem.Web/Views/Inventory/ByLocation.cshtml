@model IReadOnlyList<WarehouseManagementSystem.Model.Inventory>

@{
    ViewData["Title"] = "Inventory by Location";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    <a asp-action="Index">INVENTORY</a> &gt;
    LOCATION
</div>

<h1 class="page-title">Inventory at @ViewBag.LocationCode</h1>

<div class="wms-table-container mt-4">
    <table class="table wms-table table-hover">
        <thead>
            <tr>
                <th>Item ID</th>
                <th>Product Information</th>
                <th>Location Details</th>
                <th>Stock / Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <partial name="_InventoryListPartial" model="Model" />
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-controller="Location"
       asp-action="Details"
       asp-route-id="@ViewBag.LocationId"
       class="btn btn-outline-primary px-4 fw-bold rounded-pill">
        Back to Location Details
    </a>

    <a asp-action="Index"
       class="btn btn-outline-secondary px-4 fw-bold rounded-pill ms-2">
        &larr; Back to Inventory
    </a>
</div>