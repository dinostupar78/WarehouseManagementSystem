@model WarehouseManagementSystem.Model.Inventory
@{
    ViewData["Title"] = "Inventory Details";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">INVENTORY</a> &gt; 
    ITEM #INV-@Model?.Id.ToString("0000")
</div>
<h1 class="page-title">Inventory #INV-@Model?.Id.ToString("0000")</h1>

@if (Model == null)
{
    <div class="alert alert-secondary">Item not found.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923z"/>
                        </svg>
                    </div>
                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted" style="letter-spacing: 0.1em; font-size: 0.8rem;">Inventory Fundamentals</h5>
                        <h4 class="fw-bolder">@(Model.Product?.Name ?? "Unknown Product")</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Tracking ID</div>
                        <div class="fw-bolder text-primary fs-5">#INV-@Model.Id.ToString("0000")</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Location Zone</div>
                        <div class="fw-bolder">@(Model.Location?.Code ?? "General Area")</div>
                        <div class="small text-muted">Zone: @(Model.Location?.Zone ?? "N/A")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3" style="letter-spacing: 0.1em; font-size: 0.8rem;">Stock Metrics</h5>
                <div class="mb-4">
                    <div class="text-muted small fw-bold text-uppercase">Current Quantity</div>
                    <div class="fs-1 fw-bolder text-info">@Model.Quantity <span class="fs-6 text-muted ms-1">Units</span></div>
                </div>
                <div class="small text-muted fw-bold">Last Updated: @Model.LastUpdated.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        </div>
    </div>
}

<div class="mt-5">
    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">&larr; Back to Active Index</a>
</div>