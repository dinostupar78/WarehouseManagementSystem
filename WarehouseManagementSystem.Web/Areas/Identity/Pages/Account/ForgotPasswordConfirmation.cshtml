@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<div class="wms-auth-page">
    <div class="wms-auth-card">
        <div class="wms-auth-header">
            <div class="wms-auth-icon">WMS</div>
            <div>
                <div class="wms-auth-eyebrow">Warehouse Management System</div>
                <h1>Check your inbox</h1>
                <p>If an account exists for that email, password reset instructions have been sent.</p>
            </div>
        </div>

        <div class="alert alert-success wms-status-message" role="alert">
            Please check your email and follow the reset password link.
        </div>

        <a asp-page="./Login" class="wms-account-secondary-button text-center text-decoration-none">
            Back to login
        </a>
    </div>
</div>
