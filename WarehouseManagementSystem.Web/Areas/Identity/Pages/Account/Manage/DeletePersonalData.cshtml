@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    Account
</div>

<h1 class="page-title">Account Settings</h1>

<div class="wms-account-layout">
    <aside class="wms-account-sidebar">
        <partial name="_ManageNav" />
    </aside>

    <section class="wms-account-panel">
        <div class="wms-account-panel-header">
            <div>
                <div class="wms-account-eyebrow">Identity</div>
                <h2>Delete Personal Data</h2>
            </div>
        </div>

        <div class="alert alert-warning" role="alert">
            <p class="mb-0">
                <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
            </p>
        </div>

        <form id="delete-user" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @if (Model.RequirePassword)
            {
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
                    <label asp-for="Input.Password" class="form-label"></label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
            }
            <button class="w-100 btn btn-lg btn-danger" type="submit">Delete data and close my account</button>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
