@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt;
    Account
</div>

<h1 class="page-title">Account Settings</h1>

<div class="wms-account-layout">
    <aside class="wms-account-sidebar">
        <partial name="_ManageNav" />
    </aside>

    <section class="wms-account-panel">
        <div class="wms-account-panel-header">
            <div>
                <div class="wms-account-eyebrow">Identity</div>
                <h2>Personal Data</h2>
            </div>
        </div>

        <p class="wms-account-copy">
            Your account contains personal data that you have given us. This page allows you to download or delete that data.
        </p>
        <p class="wms-account-warning">
            <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
        </p>

        <div class="wms-account-actions">
            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <button class="wms-account-primary-button" type="submit">
                    Download data
                </button>
            </form>

            <a id="delete" asp-page="DeletePersonalData" class="wms-account-danger-button">
                Delete account
            </a>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
