@model string

@if (!String.IsNullOrEmpty(Model))
{
    var statusMessageClass = Model.StartsWith("Error") ? "danger" : "success";
    var hideCloseButton = ViewData["HideStatusCloseButton"] as bool? == true;
    var dismissibleClass = hideCloseButton ? "" : "alert-dismissible";

    <div class="alert alert-@statusMessageClass @dismissibleClass wms-status-message" role="alert">
        @if (!hideCloseButton)
        {
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        }
        @Model
    </div>
}
