@model WarehouseManagementSystem.Models.Product
@{
    ViewData["Title"] = "Product Details";
}

<div class="wms-breadcrumbs">
    <a asp-controller="Home" asp-action="Index">Dashboard</a> &gt; 
    <a asp-action="Index">PRODUCTS</a> &gt; 
    @Model?.Name
</div>
<h1 class="page-title">Product @Model?.Name</h1>

@if (Model == null)
{
    <div class="alert alert-secondary">Product not found.</div>
}
else
{
    <div class="row g-4">
        <div class="col-md-7">
            <div class="detail-card border-0 h-100">
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-primary text-white rounded p-3 me-3">
                        <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923z"/></svg>
                    </div>
                    <div>
                        <h5 class="fw-bolder mb-1 text-uppercase text-muted">Product Data</h5>
                        <h4 class="fw-bolder">@Model.Name</h4>
                    </div>
                </div>

                <div class="row mt-4 pt-3 border-top">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Tracking ID</div>
                        <div class="fw-bolder text-primary fs-5">PRD-@Model.Id.ToString("0000")</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Category</div>
                        <div class="fw-bolder">@(Model.Category?.Name ?? "Uncategorized")</div>
                    </div>
                </div>
                
                <div class="mt-2 text-muted fw-bold">
                    <p>@Model.Description</p>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="detail-card border-0 h-100">
                <h5 class="text-muted small fw-bold text-uppercase mb-3">Financial Value</h5>
                <div class="mb-4">
                    <div class="text-muted small fw-bold text-uppercase">Unit Price</div>
                    <div class="fs-1 fw-bolder text-success">@Model.Price.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="mt-5">
    <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold rounded-pill">&larr; Back to Products</a>
</div>