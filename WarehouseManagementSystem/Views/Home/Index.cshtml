@{
    ViewData["Title"] = "Dashboard";
}

<div class="wms-breadcrumbs">
    HOME &gt; DASHBOARD
</div>
<h1 class="page-title">Warehouse Overview</h1>
<p class="text-muted fw-bold mb-4">Real-time logistics and management for active operations.</p>

<div class="row mb-5 g-4">
    <div class="col-md-4">
        <div class="detail-card border-start border-4 border-primary h-100" style="border-radius: 4px;">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.1em;">Total Products</div>
                    <div class="fs-1 fw-bold text-dark mb-3">12,842</div>
                    <div class="small fw-bolder text-success">
                        <svg width="16" height="16" fill="currentColor" class="me-1 mb-1" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M8 12a.5.5 0 0 0 .5-.5V5.707l2.146 2.147a.5.5 0 0 0 .708-.708l-3-3a.5.5 0 0 0-.708 0l-3 3a.5.5 0 1 0 .708.708L7.5 5.707V11.5a.5.5 0 0 0 .5.5z"/></svg> 
                        +4.2% from last month
                    </div>
                </div>
                <div class="bg-primary bg-opacity-10 text-primary rounded p-3" style="height: 54px;">
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5 8 5.961 14.154 3.5zM15 4.239l-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923z"/></svg>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="detail-card border-start border-4 border-info h-100" style="border-radius: 4px;">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.1em;">Active Suppliers</div>
                    <div class="fs-1 fw-bold text-dark mb-3">148</div>
                    <div class="small fw-bolder text-dark">
                        <svg width="16" height="16" fill="currentColor" class="me-1 mb-1 text-dark" viewBox="0 0 16 16"><path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z"/></svg> 
                        All vendors compliant
                    </div>
                </div>
                <div class="bg-info bg-opacity-10 text-info rounded p-3" style="height: 54px;">
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"/></svg>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="detail-card border-start border-4 border-danger h-100" style="border-radius: 4px;">
            <div class="d-flex justify-content-between">
                <div>
                    <div class="text-muted small fw-bold text-uppercase mb-2" style="letter-spacing: 0.1em;">Pending Orders</div>
                    <div class="fs-1 fw-bold text-dark mb-3">24</div>
                    <div class="small fw-bolder text-danger">
                        <svg width="16" height="16" fill="currentColor" class="me-1 mb-1" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/><path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/></svg> 
                        3 Require Immediate Action
                    </div>
                </div>
                <div class="bg-danger bg-opacity-10 text-danger rounded p-3" style="height: 54px;">
                    <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2zM9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5v2zM8 5a.5.5 0 0 1 .5.5v3.793l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 1 1 .708-.708L7.5 9.293V5.5A.5.5 0 0 1 8 5z"/></svg>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="detail-card border-0 h-100" style="padding: 1.5rem; background-color: var(--card-bg);">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="fw-bolder text-uppercase m-0" style="letter-spacing: 0.1em;">Recent Inventory Movements</h6>
                <a asp-controller="Inventory" asp-action="Index" class="fw-bold text-primary text-decoration-none small">View All</a>
            </div>
            
            <table class="table wms-table mb-0 table-hover mt-3">
                <thead style="background-color: #eef2ff;">
                    <tr>
                        <th class="ps-3 border-0">Item ID</th>
                        <th class="border-0">Warehouse</th>
                        <th class="border-0">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-3 text-primary fw-bolder small border-0 py-3">#SKU-9921</td>
                        <td class="border-0 py-3 text-dark fw-bold">Sector A-4</td>
                        <td class="border-0 py-3"><span class="badge bg-success py-1 px-2">IN STOCK</span></td>
                    </tr>
                    <tr>
                        <td class="ps-3 text-primary fw-bolder small border-0 py-3">#SKU-8842</td>
                        <td class="border-0 py-3 text-dark fw-bold">Sector B-1</td>
                        <td class="border-0 py-3"><span class="badge bg-warning text-dark py-1 px-2">LOW STOCK</span></td>
                    </tr>
                    <tr>
                        <td class="ps-3 text-primary fw-bolder small border-0 py-3">#SKU-4410</td>
                        <td class="border-0 py-3 text-dark fw-bold">Sector C-12</td>
                        <td class="border-0 py-3"><span class="badge bg-success py-1 px-2">IN STOCK</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-md-4">
        <div class="detail-card border-0 h-100 d-flex flex-column" style="background-color: #ffffff;">
            <div class="mb-auto">
                <h6 class="fw-bolder mb-4 text-uppercase d-flex align-items-center text-dark" style="letter-spacing: 0.1em;">
                    <svg width="18" height="18" fill="currentColor" class="me-2 text-primary" viewBox="0 0 16 16"><path d="M14 1a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h12zM2 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H2z"/><path d="M4.5 4a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 1 0v-7a.5.5 0 0 0-.5-.5zm3 0a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 1 0v-7a.5.5 0 0 0-.5-.5zm3 0a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 1 0v-7a.5.5 0 0 0-.5-.5z"/></svg> 
                    Storage Efficiency
                </h6>
                <div class="progress mb-2 bg-white border" style="height: 8px; border-radius: 4px;">
                    <div class="progress-bar bg-primary" role="progressbar" style="width: 78%; border-radius: 4px;" aria-valuenow="78" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <div class="d-flex justify-content-between text-muted small fw-bolder mb-4">
                    <span style="font-size: 0.7rem">78% CAPACITY USED</span>
                    <span style="font-size: 0.7rem text-dark">2.4K M³ FREE</span>
                </div>
                <p class="text-muted" style="font-size: 0.85rem; line-height: 1.6;">Warehouse Sector A and B are near peak capacity. Consider rerouting incoming SKU-400 series to Sector C.</p>
            </div>
        </div>
    </div>
</div>